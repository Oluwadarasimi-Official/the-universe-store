# Copy to .env.local for local dev. NEVER commit real values.
# ---- Public (safe in browser) ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=
# One-time token (>=24 chars) to claim the first Owner at /hq-autopilot-4x9/setup
ADMIN_SETUP_TOKEN=
# 32 random bytes, base64 (openssl rand -base64 32): encrypts AI keys pasted in the admin
APP_ENCRYPTION_KEY=
# Random string: salts IP hashes used only for rate limiting
RATE_LIMIT_SALT=
# Random string: Vercel Cron bearer secret for /api/cron/automations
CRON_SECRET=

# ---- AI providers (optional; unset = "Not configured") ----
DARAX_API_KEY=
DARAX_API_BASE_URL=
DARAX_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
